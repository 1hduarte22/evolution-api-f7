# Domínio apontando para o IP da VM (grátis: um subdomínio do DuckDNS, ex.: f7-evolution.duckdns.org)
EVOLUTION_DOMAIN=f7-evolution.duckdns.org
# Gere uma chave longa: openssl rand -hex 24  (a mesma vai no segredo EVOLUTION_API_KEY do Supabase)
AUTHENTICATION_API_KEY=
# Supabase → Project Settings → Database → Connection string → Session pooler (porta 5432), com ?schema=evolution no fim
DATABASE_CONNECTION_URI=postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?schema=evolution
